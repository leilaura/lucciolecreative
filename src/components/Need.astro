---
import { rich } from '../lib/text';
import type { Home } from '../lib/types';

interface Props { need: Home['need'] }
const { need } = Astro.props;
---
<section class="pband band" aria-labelledby="need-t">
  <div class="wrap pb-in">
    <div class="pb-t">
      <p class="eyebrow">{need.eyebrow}</p>
      <h2 id="need-t" set:html={rich(need.title)} />
      <p>{need.text}</p>
    </div>
    <img class="pb-img" src={need.image.url} alt={need.image.alt} width="415" height="624" loading="lazy" />
  </div>
</section>

<section class="familiar blk band" aria-label="Le situazioni in cui ci riconosci">
  <div class="wrap">
    <div class="quotes">
      {need.quotes.map((q) => (
        <figure class="q">
          <blockquote><p>{q.quote}</p></blockquote>
          <figcaption><b>{q.label}</b> {q.text}</figcaption>
        </figure>
      ))}
    </div>
    <div class="answer">
      <h3 set:html={rich(need.answerTitle)} />
      <p>{need.answerText}</p>
    </div>
  </div>
</section>

<style>
  .familiar { background: var(--crema); }
  .quotes { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .q {
    margin: 0; background: #fff; border: 1px solid var(--line); border-radius: var(--r);
    padding: 26px 22px 22px; display: flex; flex-direction: column; gap: 18px; min-width: 0;
  }
  .q::before { content: '“'; font: italic 400 3.2rem/.6 var(--f-serif); color: var(--azzurro-deep); height: .4em; }
  blockquote { margin: 0; }
  blockquote p { font-family: var(--f-serif); font-size: 1.5rem; line-height: 1.14; }
  figcaption { margin-top: auto; font-size: .9rem; color: var(--ink-soft); }
  figcaption b { color: var(--ink); }
  .answer {
    margin-top: 48px; display: grid; grid-template-columns: 1.1fr 1fr; gap: 20px 40px; align-items: center;
    background: var(--ink); color: var(--crema); border-radius: calc(var(--r) + 6px); padding: clamp(28px, 4vw, 48px);
  }
  .answer h3 { font-size: clamp(1.7rem, 3.4vw, 2.7rem); }
  .answer h3 :global(.it) { color: var(--giallo); }
  .answer p { color: #c9d3ea; max-width: 36em; }
  @media (max-width: 980px) { .quotes { grid-template-columns: repeat(2, 1fr); } .answer { grid-template-columns: 1fr; } }
  @media (max-width: 540px) { .quotes { grid-template-columns: 1fr; } }
</style>
