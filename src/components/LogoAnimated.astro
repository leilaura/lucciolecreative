---
// Logo dell'hero animato: le lettere cadono una alla volta e si posano senza scatti,
// poi la lucciola si accende e pulsa piano. Con "riduci movimento" resta fermo e completo.
import logoRaw from '../../public/logo.svg?raw';

const letters = [...logoRaw.matchAll(/<path id="\w+" class="cls-2" d="([^"]+)"\/>/g)].map((m) => m[1]);
---
<div class="logo-anim" aria-hidden="true">
  <svg viewBox="0 0 334.53 334.53" data-logo>
    <defs>
      <radialGradient id="logo-glow">
        <stop offset="0" stop-color="#ffd731" stop-opacity=".85" />
        <stop offset=".4" stop-color="#ffd731" stop-opacity=".25" />
        <stop offset="1" stop-color="#ffd731" stop-opacity="0" />
      </radialGradient>
    </defs>
    <circle cx="167.27" cy="167.27" r="167.27" fill="#9eb6dc" />
    <g fill="#fff3dd">
      {letters.map((d) => <path class="letter" d={d} />)}
    </g>
    <g class="dotg">
      <circle class="glow" cx="302.23" cy="154.85" r="60" fill="url(#logo-glow)" />
      <circle cx="302.23" cy="154.85" r="16.5" fill="#ffd731" />
    </g>
  </svg>
</div>

<script>
  const svg = document.querySelector<SVGSVGElement>('[data-logo]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (svg && !reduce) {
    const out = 'cubic-bezier(.22, 1, .36, 1)'; // ease-out senza rimbalzo
    const letters = [...svg.querySelectorAll<SVGPathElement>('.letter')];
    const gap = 110;
    const fall = 1200;

    letters.forEach((p, i) => {
      p.animate(
        [
          { transform: 'translateY(-260px) rotate(-12deg)', opacity: 0 },
          { opacity: 1, offset: 0.2 },
          { transform: 'translateY(0) rotate(0)', opacity: 1 },
        ],
        { duration: fall, delay: 200 + gap * i, easing: out, fill: 'both' },
      );
    });

    const end = 200 + gap * (letters.length - 1) + fall;
    const dot = svg.querySelector<SVGGElement>('.dotg')!;
    dot.animate([{ opacity: 0, transform: 'scale(0)' }, { opacity: 1, transform: 'scale(1)' }], {
      duration: 900, delay: end - 200, easing: out, fill: 'both',
    });
    svg.querySelector('.glow')!.animate([{ opacity: 0.5 }, { opacity: 1 }, { opacity: 0.5 }], {
      duration: 3200, delay: end + 700, iterations: Infinity, easing: 'ease-in-out',
    });
  }
</script>

<style>
  .logo-anim { width: min(460px, 100%); justify-self: center; }
  svg { display: block; width: 100%; height: auto; overflow: visible; }
  .letter, .dotg { transform-box: fill-box; transform-origin: center; }
  /* Con JS attivo le lettere partono nascoste (niente lampo del logo completo prima dell'animazione) */
  :global(.js) .letter, :global(.js) .dotg { opacity: 0; }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .letter, :global(.js) .dotg { opacity: 1; }
  }
  @media (max-width: 820px) {
    .logo-anim { width: min(220px, 56%); order: -1; justify-self: start; }
  }
</style>
