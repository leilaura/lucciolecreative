---
import { rich } from '../lib/text';
import type { Faq } from '../lib/types';

interface Props { title: string; faqs: Faq[] }
const { title, faqs } = Astro.props;
---
<section class="faq blk band" aria-labelledby="fq-t">
  <div class="wrap">
    <h2 id="fq-t" set:html={rich(title)} />
    <div>
      {faqs.map((f, i) => (
        <details open={i === 0}>
          <summary>{f.question}</summary>
          <p>{f.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { background: var(--crema); }
  .wrap { display: grid; grid-template-columns: .8fr 1.2fr; gap: 40px; }
  details { border-bottom: 1px solid var(--line); padding-block: 18px; }
  summary {
    list-style: none; cursor: pointer; display: flex; justify-content: space-between; gap: 16px;
    font: 700 1.12rem var(--f-body); min-height: 44px; align-items: center;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; font: 400 1.6rem/1 var(--f-display); transition: transform .2s; color: var(--azzurro-deep); }
  details[open] summary::after { transform: rotate(45deg); }
  details p { margin-top: 10px; color: var(--ink-soft); max-width: 40em; }
  @media (max-width: 820px) { .wrap { grid-template-columns: 1fr; } }
</style>
