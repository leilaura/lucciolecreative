---
import { rich } from '../lib/text';
import type { Home } from '../lib/types';

interface Props { approach: Home['approach'] }
const { approach } = Astro.props;
---
<section class="spot band" id="metodo" aria-labelledby="ap-t" data-spot>
  <div class="wrap spot-in">
    <div class="spot-t">
      <p class="eyebrow">{approach.eyebrow}</p>
      <h2 id="ap-t" set:html={rich(approach.title)} />
      <p>{approach.text}</p>
    </div>
    <div class="ld">
      {approach.pillars.map((p) => (
        <article>
          <span class="big">{p.big}<span class="lux" aria-hidden="true"></span></span>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </article>
      ))}
    </div>
    <ul class="pairs">
      {approach.pairs.map((p) => (
        <li><span>{p.from}</span><span class="arr" aria-hidden="true"></span><span>{p.to}</span></li>
      ))}
    </ul>
  </div>
</section>

<section class="light blk band" aria-label="In cosa crediamo">
  <div class="wrap">
    <div class="credo">
      <div>
        <p class="eyebrow">In cosa crediamo</p>
        <p class="quote" set:html={rich(approach.beliefsQuote)} />
      </div>
      <ul class="beliefs">
        {approach.beliefs.map((b) => (
          <li><div><h3>{b.title}</h3><p>{b.text}</p></div></li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  // Una luce calda segue il mouse nella fascia marrone: "lo illuminiamo"
  const spot = document.querySelector<HTMLElement>('[data-spot]');
  if (spot && !matchMedia('(prefers-reduced-motion: reduce)').matches && matchMedia('(pointer: fine)').matches) {
    spot.addEventListener('pointermove', (e) => {
      const r = spot.getBoundingClientRect();
      spot.style.setProperty('--sx', e.clientX - r.left + 'px');
      spot.style.setProperty('--sy', e.clientY - r.top + 'px');
    });
  }
</script>

<style>
  /* Fascia marrone con la luce che segue il mouse (su touch: una luce che respira) */
  .spot {
    --sx: 30%; --sy: 30%;
    position: relative; overflow: hidden; color: var(--crema);
    background:
      radial-gradient(380px circle at var(--sx) var(--sy), rgba(253, 214, 49, .09), rgba(253, 214, 49, 0) 70%),
      var(--marrone);
  }
  .spot-in { padding-block: clamp(72px, 10vw, 130px); display: grid; gap: clamp(48px, 6vw, 80px); }
  .spot-t { display: grid; gap: 22px; max-width: 46em; }
  .spot-t .eyebrow { color: var(--giallo); }
  .spot-t h2 :global(.it) { color: var(--giallo); text-shadow: 0 0 .5em rgba(253, 214, 49, .45); }
  .spot-t p { color: #ebdccd; font-size: 1.08rem; max-width: 34em; }
  .ld { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 5vw, 72px); }
  .ld article { display: grid; gap: 12px; align-content: start; padding-top: 22px; border-top: 1px solid rgba(255, 251, 242, .22); min-width: 0; }
  .big {
    position: relative; width: fit-content;
    font: 600 clamp(2.4rem, 4.6vw, 3.6rem)/.95 'ivybodoni-condensed', var(--f-serif); letter-spacing: -.01em;
  }
  .ld article:first-child .big { color: var(--giallo); }
  .lux {
    position: absolute; right: -.22em; top: .02em; width: .12em; height: .12em; border-radius: 50%;
    background: var(--giallo); box-shadow: 0 0 .15em .05em rgba(253, 214, 49, .9), 0 0 .6em .2em rgba(253, 214, 49, .35);
    animation: lux 3.4s ease-in-out infinite;
  }
  .ld article:last-child .lux { animation-delay: -1.7s; }
  @keyframes lux { 50% { opacity: .35; scale: .8; } }
  .ld h3 { font-size: 1.2rem; }
  .ld p { color: #ebdccd; }
  .pairs { list-style: none; margin: 0; padding: 0; }
  .pairs li {
    display: grid; grid-template-columns: minmax(0, 1fr) 72px minmax(0, 1fr); gap: 18px; align-items: center;
    padding: 18px 0; border-top: 1px solid rgba(255, 251, 242, .16); font-size: 1rem; color: #ebdccd;
  }
  .pairs li:last-child { border-bottom: 1px solid rgba(255, 251, 242, .16); }
  .arr { position: relative; height: 2px; background: linear-gradient(90deg, rgba(253, 214, 49, 0), var(--giallo)); }
  .arr::after {
    content: ''; position: absolute; right: -2px; top: 50%; width: 8px; height: 8px; margin-top: -4px; border-radius: 50%;
    background: var(--giallo); box-shadow: 0 0 10px 3px rgba(253, 214, 49, .7);
  }
  .pairs li span:last-child { font: italic 600 clamp(1.15rem, 1.6vw, 1.3rem)/1.2 var(--f-serif); color: var(--crema); transition: color .3s; }
  .pairs li:hover span:last-child { color: var(--giallo); }
  @media (prefers-reduced-motion: reduce) { .lux { animation: none; } }
  @media (max-width: 760px) {
    .ld { grid-template-columns: 1fr; }
    .pairs li { grid-template-columns: 1fr; gap: 4px; }
    .arr { display: none; }
  }

  .light { background: var(--azzurro-pale); }
  .credo {
    display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(32px, 6vw, 90px); align-items: start;
  }
  .credo .eyebrow { margin-bottom: 18px; }
  .quote { font: 700 clamp(1.9rem, 3.4vw, 2.8rem)/1.1 var(--f-display); letter-spacing: -.02em; text-wrap: balance; }
  .quote :global(.it) { display: block; color: var(--azzurro-deep); margin-top: .15em; }
  .beliefs { list-style: none; padding: 0; margin: 0; }
  .beliefs li { display: grid; grid-template-columns: 28px 1fr; gap: 16px; padding: 20px 0; border-top: 1px solid var(--line); }
  .beliefs li:last-child { border-bottom: 1px solid var(--line); }
  .beliefs li::before {
    content: ''; width: 16px; height: 16px; border-radius: 50%; margin-top: 5px;
    background: var(--giallo); box-shadow: 0 0 10px 2px rgba(253, 214, 49, .7);
  }
  .beliefs h3 { font-size: 1.2rem; margin-bottom: 4px; }
  .beliefs p { color: var(--ink-soft); }
  @media (max-width: 860px) { .credo { grid-template-columns: 1fr; } }
</style>
