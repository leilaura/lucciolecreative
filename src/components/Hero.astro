---
import { rich } from '../lib/text';
import LogoAnimated from './LogoAnimated.astro';
import type { Home } from '../lib/types';

interface Props { hero: Home['hero'] }
const { hero } = Astro.props;
// Il punto finale del titolo diventa la lucina gialla
const title = hero.title.trim().replace(/\.$/, '');
---
<section class="hero band" aria-labelledby="hero-t">
  <div class="wrap hero-in">
    <div>
      <h1 id="hero-t"><Fragment set:html={rich(title) + '&#8288;'} /><span class="lucina" aria-hidden="true"></span></h1>
      <p class="lead">{hero.lead}</p>
      <div class="ctas">
        <a class="btn btn-y" href="#contatti">{hero.ctaPrimary}</a>
        <a class="btn btn-o" href="#metodo">{hero.ctaSecondary}</a>
      </div>
    </div>
    <LogoAnimated />
  </div>
</section>

<style>
  /* Hero azzurro: titolo a sinistra, logo grande a destra */
  .hero { background: var(--azzurro); overflow: hidden; }
  .hero-in {
    display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 72px); align-items: center;
    padding-block: clamp(40px, 6vw, 88px);
  }
  h1 { font-size: clamp(2.3rem, 4.4vw, 3.9rem); line-height: 1.02; letter-spacing: -.025em; max-width: 15em; }
  h1 :global(.it) { font-weight: 700; }
  /* La lucina: il punto finale del titolo, giallo e acceso */
  .lucina {
    display: inline-block; width: .17em; height: .17em; margin-left: .06em; border-radius: 50%;
    background: var(--giallo); vertical-align: baseline;
    box-shadow: 0 0 .12em .04em rgba(253, 214, 49, .9), 0 0 .5em .12em rgba(253, 214, 49, .45);
    animation: lucina 3.2s ease-in-out 1s infinite;
  }
  @keyframes lucina { 50% { box-shadow: 0 0 .08em .02em rgba(253, 214, 49, .7), 0 0 .28em .06em rgba(253, 214, 49, .25); } }
  @media (prefers-reduced-motion: reduce) { .lucina { animation: none; } }
  .lead { max-width: 36em; font-size: clamp(1.05rem, 1.4vw, 1.2rem); margin-top: 22px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }

  @media (max-width: 820px) {
    .hero-in { grid-template-columns: 1fr; }
  }

</style>
