---
import { rich } from '../lib/text';
import type { Home, Project } from '../lib/types';

interface Props { intro: Home['projects']; projects: Project[] }
const { intro, projects } = Astro.props;

const featured = projects.find((p) => p.featured) ?? projects[0];
const rest = projects.filter((p) => p !== featured);
const filters = [...new Set(projects.flatMap((p) => p.services))];
---
<section class="projects blk band" id="progetti" aria-labelledby="pr-t">
  <div class="wrap">
    <div class="head-row">
      <h2 id="pr-t" set:html={rich(intro.title)} />
      {filters.length > 1 && rest.length > 0 && (
        <div class="filters" role="group" aria-label="Filtra i progetti" data-filters>
          <button class="chip" type="button" aria-pressed="true" data-f="all">Tutti</button>
          {filters.map((f) => <button class="chip" type="button" aria-pressed="false" data-f={f}>{f}</button>)}
        </div>
      )}
    </div>

    <article class="feat">
      <div class="cover">
        {featured.cover ? <img src={featured.cover.url} alt={featured.cover.alt} loading="lazy" /> : <span class="ph">[copertina]</span>}
      </div>
      <div>
        <span class="eyebrow">In evidenza · {featured.sector}{featured.year && ` · ${featured.year}`}</span>
        <h3>{featured.client}</h3>
        <p>{featured.summary}</p>
        <div class="tags">{featured.services.map((s) => <span>{s}</span>)}</div>
      </div>
    </article>

    {rest.length > 0 && (
      <div class="grid4" data-grid>
        {rest.map((p) => (
          <article class="card" data-c={p.services.join('|')}>
            <div class="cover">
              {p.cover ? <img src={p.cover.url} alt={p.cover.alt} loading="lazy" /> : <span class="ph">[copertina]</span>}
            </div>
            <span class="meta">{p.services.join(' · ')}</span>
            <h4>{p.client}</h4>
            <span class="meta">{[p.sector, p.year].filter(Boolean).join(' · ')}</span>
          </article>
        ))}
      </div>
    )}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-filters]').forEach((group) => {
    const chips = [...group.querySelectorAll<HTMLButtonElement>('.chip')];
    const cards = [...document.querySelectorAll<HTMLElement>('[data-grid] .card')];
    chips.forEach((c) =>
      c.addEventListener('click', () => {
        chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
        const f = c.dataset.f!;
        cards.forEach((k) => (k.hidden = !(f === 'all' || k.dataset.c!.split('|').includes(f))));
      }),
    );
  });
</script>

<style>
  .projects { background: var(--crema); }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; justify-content: flex-end; }
  .chip {
    font: 600 .92rem var(--f-body); color: var(--ink); background: #fff; min-height: 44px;
    border: 1.5px solid var(--line-strong); border-radius: 14px; padding: .55em 1.05em; cursor: pointer;
  }
  .chip[aria-pressed='true'] { background: var(--ink); color: var(--crema); border-color: var(--ink); }
  .feat { display: grid; grid-template-columns: 1.2fr 1fr; gap: 36px; align-items: center; margin-bottom: 22px; }
  .cover {
    background: var(--azzurro-pale); border-radius: var(--r); aspect-ratio: 4 / 3; overflow: hidden;
    display: flex; align-items: flex-end; padding: 14px; border: 1px solid var(--line);
  }
  .cover img { width: 100%; height: 100%; object-fit: cover; margin: -14px; width: calc(100% + 28px); height: calc(100% + 28px); max-width: none; }
  .ph { font-size: .8rem; color: var(--ink-soft); }
  .feat h3 { font-size: clamp(1.8rem, 3.4vw, 2.6rem); margin: 10px 0 12px; }
  .feat p { color: var(--ink-soft); }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 16px; }
  .tags span { font-size: .85rem; font-weight: 600; border: 1px solid var(--line); border-radius: 999px; padding: .3em .8em; background: #fff; }
  .grid4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .card { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .card[hidden] { display: none; }
  .card .cover { aspect-ratio: 1; }
  .card h4 { font-size: 1.15rem; }
  .meta { font-size: .88rem; color: var(--ink-soft); }
  @media (max-width: 900px) { .feat { grid-template-columns: 1fr; } .grid4 { grid-template-columns: 1fr 1fr; } }
</style>
