---
import { rich } from '../lib/text';
import type { Home, SiteSettings } from '../lib/types';

interface Props { night: Home['night']; settings: SiteSettings; showProjects: boolean }
const { night, settings, showProjects } = Astro.props;
const year = new Date().getFullYear();
const legal = [settings.legalName, settings.vatNumber && `P.IVA ${settings.vatNumber}`].filter(Boolean).join(' · ');
---
<div class="night band" data-night>
  <canvas aria-hidden="true"></canvas>

  <section class="wrap closing" aria-labelledby="nt-t">
    <h2 id="nt-t" set:html={rich(night.title)} />
    <p>{night.text}</p>
    <a class="btn btn-y" href="#contatti">{night.cta}</a>
  </section>

  <footer class="wrap">
    <div class="f-top">
      <div class="f-brand">
        <img src="/logo.svg" alt="" width="36" height="36" />
        <span>© {year} {settings.name}{legal && ` · ${legal}`} · <a href={`mailto:${settings.email}`}>{settings.email}</a></span>
      </div>
      <ul class="f-links">
        <li><a href={`https://www.instagram.com/${settings.instagram}`} target="_blank" rel="noopener">Instagram</a></li>
        <li><a href="/privacy">Privacy</a></li>
      </ul>
    </div>
  </footer>
</div>

<script>
  import { initFireflies } from '../scripts/fireflies';
  const area = document.querySelector<HTMLElement>('[data-night]');
  const canvas = area?.querySelector('canvas');
  if (area && canvas) initFireflies(canvas, area);
</script>

<style>
  .night {
    position: relative; overflow: hidden; color: var(--crema);
    background: linear-gradient(180deg, #070c22 0%, #0e1a44 55%, #24345f 100%);
  }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .closing, footer { position: relative; }
  .closing {
    padding-block: clamp(100px, 15vw, 140px) clamp(70px, 10vw, 120px);
    display: flex; flex-direction: column; align-items: center; text-align: center; gap: 28px;
  }
  h2 {
    font: 600 clamp(2.4rem, 5.2vw, 4.4rem)/1.04 'ivybodoni-condensed', var(--f-serif);
    letter-spacing: 0; max-width: 12em;
  }
  h2 :global(.it) { font-weight: 700; font-size: 1em; }
  .closing p { color: #c9d3ea; max-width: 30em; font-size: 1.12rem; }

  footer { padding-block: 32px 28px; display: grid; gap: 24px; border-top: 1px solid rgba(255, 255, 255, .12); color: #c9d3ea; }
  .f-top { font-size: .85rem; display: flex; flex-wrap: wrap; gap: 20px 40px; align-items: center; justify-content: space-between; }
  .f-brand { display: flex; align-items: center; gap: 12px; }
  .f-brand img { width: 36px; height: 36px; flex: none; }
  .pay { font: italic 600 1.4rem var(--f-serif); color: var(--crema); }
  .f-links { display: flex; gap: 6px 24px; list-style: none; margin: 0; padding: 0; }
  .f-links a { text-decoration: none; font-weight: 600; padding: 6px 0; }
  .f-links a:hover { color: var(--giallo); }
  .f-bot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px; font-size: .88rem; }
  footer :focus-visible, .closing :focus-visible { outline-color: var(--giallo); }
</style>
