---
import { rich } from '../lib/text';
import type { Home, Service } from '../lib/types';

interface Props { intro: Home['services']; services: Service[] }
const { intro, services } = Astro.props;
---
<section class="services blk band" id="servizi" aria-labelledby="svc-t">
  <div class="wrap">
    <div class="head-row">
      <h2 id="svc-t" set:html={rich(intro.title)} />
      <p>{intro.text}</p>
    </div>

    <div class="svc" data-tabs>
      <div class="tabs" role="tablist" aria-label="Servizi">
        {services.map((s, i) => (
          <button
            class="tab"
            role="tab"
            type="button"
            id={`tab-${s.id}`}
            aria-controls={`panel-${s.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >{s.title}</button>
        ))}
      </div>

      {services.map((s, i) => (
        <div class="panel" role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} hidden={i !== 0}>
          <div class="txt">
            <h3>{s.title}</h3>
            <p class="intro">{s.intro}</p>
            <ul>{s.items.map((it) => <li>{it}</li>)}</ul>
            <p class="who"><b>Per chi è:</b> {s.forWho}</p>
            <a class="btn btn-ink" href="#contatti">Parliamone</a>
          </div>
          {s.image && (
            <div class="shot">
              <img src={s.image.url} alt={s.image.alt} width="414" height="624" loading="lazy" />
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Schede accessibili: click, frecce, Home/Fine. Senza JS si vede solo la prima (le altre restano nel codice).
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls')!)!);
    const show = (i: number, focus = false) => {
      tabs.forEach((t, j) => {
        const on = i === j;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        panels[j].hidden = !on;
      });
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => t.addEventListener('click', () => show(i)));
    root.querySelector('[role="tablist"]')!.addEventListener('keydown', (e) => {
      const ev = e as KeyboardEvent;
      const i = tabs.indexOf(document.activeElement as HTMLButtonElement);
      if (i < 0) return;
      const keys: Record<string, number> = {
        ArrowDown: (i + 1) % tabs.length, ArrowRight: (i + 1) % tabs.length,
        ArrowUp: (i - 1 + tabs.length) % tabs.length, ArrowLeft: (i - 1 + tabs.length) % tabs.length,
        Home: 0, End: tabs.length - 1,
      };
      if (!(ev.key in keys)) return;
      ev.preventDefault();
      show(keys[ev.key], true);
    });
  });
</script>

<style>
  .services { background: var(--crema); }
  .svc { display: grid; grid-template-columns: 300px 1fr; gap: 28px; align-items: start; }
  .tabs { display: flex; flex-direction: column; gap: 10px; grid-row: 1 / span 10; }
  .tab {
    display: flex; align-items: center; gap: 12px; width: 100%; min-height: 52px; text-align: left;
    font: 600 1.05rem var(--f-body); color: var(--ink); background: #fff;
    border: 1.5px solid var(--line); border-radius: 999px; padding: .85em 1.2em; cursor: pointer;
    transition: border-color .15s, background .15s;
  }
  .tab::before {
    content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--line); flex: none;
    transition: background .2s, box-shadow .2s;
  }
  .tab:hover { border-color: var(--ink); }
  .tab[aria-selected='true'] { border-color: var(--ink); background: var(--azzurro-pale); }
  .tab[aria-selected='true']::before { background: var(--giallo); box-shadow: 0 0 8px 2px rgba(253, 214, 49, .9); }

  .panel {
    grid-column: 2; overflow: hidden; background: var(--azzurro-pale); border-radius: calc(var(--r) + 6px);
    display: grid; grid-template-columns: 1.1fr .9fr; min-width: 0;
  }
  .panel[hidden] { display: none; }
  .txt { padding: clamp(24px, 3.5vw, 40px); }
  .panel h3 { font-size: clamp(1.7rem, 3vw, 2.3rem); }
  .intro { margin-top: 10px; color: var(--ink-soft); font-size: 1.05rem; }
  .panel ul { list-style: none; padding: 0; margin: 20px 0; display: grid; gap: 8px; }
  .panel li { display: flex; gap: 10px; align-items: baseline; }
  .panel li::before {
    content: ''; width: 7px; height: 7px; flex: none; border-radius: 50%;
    background: var(--giallo); transform: translateY(-2px); box-shadow: 0 0 0 2px rgba(27, 38, 69, .08);
  }
  .who { font-size: .98rem; border-top: 1px dashed var(--line); padding-top: 16px; margin-bottom: 22px; }
  .shot { position: relative; min-height: 440px; background: var(--crema); }
  .shot img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }

  @media (max-width: 900px) {
    .svc { grid-template-columns: 1fr; }
    .tabs { flex-direction: row; flex-wrap: wrap; grid-row: auto; }
    .tab { width: auto; }
    .panel { grid-column: 1; grid-template-columns: 1fr; }
    .shot { min-height: 340px; }
  }
</style>
